package async_tcp_connect

import std.io
import std.net
import std.result

fn report(result: Result<TcpStream, NetError>) {
    match result {
        Ok(stream) => {
            io.println("connected")
            stream.close()
        }
        Err(error) => {
            io.println(error.message)
        }
    }
}

suspend fn main() {
    let result: Result<TcpStream, NetError> = net.connect("example.invalid", 443, 250)
    report(result)
}

package async_timer

import std.io
import std.result
import std.task
import std.time

suspend fn main() {
    io.println("before timer")
    let immediate: Result<void, TaskError> = task.sleep(time.duration_millis(0))
    io.println(result.is_ok(immediate))
    let waited: Result<void, TaskError> = task.sleep(time.duration_millis(50))
    io.println(result.is_ok(waited))
    io.println("after timer")
}

package concurrent_openai_compatible

import std.array
import std.env
import std.http
import std.io
import std.string
import std.task

fn request_worker(context: TaskContext, endpoint: string) -> string {
    let mut headers: Array<HttpHeader> = Array.new<HttpHeader>()
    headers.push(HttpHeader { name: "Authorization", value: "Bearer local-task-token" })
    headers.push(HttpHeader { name: "Content-Type", value: "application/json" })
    let request: HttpRequest = HttpRequest { method: "POST", url: string.concat(endpoint, "/v1/chat/completions"), headers: headers, body: "{\"model\":\"nomo-task-fixture\",\"messages\":[{\"role\":\"user\",\"content\":\"Hello concurrently\"}],\"stream\":false}", timeout_millis: 5000, max_response_bytes: 1048576 }
    let response: Result<HttpResponse, HttpError> = http.send_blocking(request)
    return match response {
        Ok(value) => value.body
        Err(error) => error.code
    }
}

fn run_requests(endpoint: string) -> Result<void, TaskError> {
    let first: Task = task.spawn(request_worker, endpoint)?
    let second: Task = task.spawn(request_worker, endpoint)?
    let first_join: TaskJoin = task.join(first, 10000)?
    let second_join: TaskJoin = task.join(second, 10000)?
    match first_join {
        TaskJoin.Completed(value) => {
            io.println(value)
        }
        TaskJoin.Cancelled => {
            io.println("cancelled")
        }
        TaskJoin.Timeout => {
            io.println("timeout")
        }
    }
    match second_join {
        TaskJoin.Completed(value) => {
            io.println(value)
        }
        TaskJoin.Cancelled => {
            io.println("cancelled")
        }
        TaskJoin.Timeout => {
            io.println("timeout")
        }
    }
    task.close(first)?
    task.close(second)?
    return Ok(void)
}

fn main() {
    let endpoint: Option<string> = env.get("NOMO_OPENAI_BASE_URL")
    match endpoint {
        Some(value) => {
            let result: Result<void, TaskError> = run_requests(value)
            match result {
                Ok(done) => {
                }
                Err(error) => {
                    io.println(error.code)
                }
            }
        }
        None => {
            io.println("missing NOMO_OPENAI_BASE_URL")
        }
    }
}

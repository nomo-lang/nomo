package file_handle

import std.env
import std.fs
import std.io
import std.path

fn close_and_label(file: File) -> string {
    defer file.close()
    return "file handle ok"
}

fn main() {
    let file_path: string = path.join(env.temp_dir(), "nomo-file-handle-example.txt")
    let write_result: Result<void, FsError> = fs.write_string(file_path, "file handle ok")
    let open_result: Result<File, FsError> = match write_result {
        Ok(ignored) => fs.open(file_path)
        Err(err) => Err(err)
    }
    let message: string = match open_result {
        Ok(file) => close_and_label(file)
        Err(err) => err.message
    }
    io.println(message)
}

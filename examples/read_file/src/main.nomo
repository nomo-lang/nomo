package read_file

import std.env
import std.fs
import std.io
import std.path

fn load(path: string) -> Result<string, FsError> {
    let text: string = fs.read_to_string(path)?
    return Ok(text)
}

fn main() {
    let file_path: string = path.join(env.temp_dir(), "nomo-read-file-example.txt")
    let write_result: Result<void, FsError> = fs.write_string(file_path, "file ok")
    let read_result: Result<string, FsError> = match write_result {
        Ok(ignored) => load(file_path)
        Err(err) => Err(err)
    }
    let message: string = match read_result {
        Ok(text) => text
        Err(err) => err.message
    }
    io.println(message)
}

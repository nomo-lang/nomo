{
  "schema": 1,
  "suite": "nomo-async-runtime",
  "phase": "P2",
  "result_schema_version": 2,
  "comparison_policy": {
    "minimum_measured_runs": 5,
    "same_host_required": true,
    "same_output_bytes_required": true,
    "design_targets": {
      "throughput_ratio_nomo_over_go": 1.1,
      "rss_ratio_nomo_over_go": 0.8,
      "p99_nomo_no_worse_than_go": true
    },
    "targets_are_merge_blockers": false,
    "marketing_claims_allowed": false
  },
  "toolchains": {
    "go": {
      "version": "go1.25.12",
      "build_flags": [
        "-trimpath",
        "-buildvcs=false",
        "-ldflags=-buildid="
      ],
      "environment": {
        "CGO_ENABLED": "0",
        "GOMAXPROCS": "1"
      },
      "integrity": "record the resolved Go binary SHA-256 in every result"
    },
    "nomo": {
      "build_flags": [
        "build"
      ],
      "integrity": "record the resolved Nomo binary SHA-256 and Git revision in every result"
    }
  },
  "defaults": {
    "warmup_runs": 2,
    "measured_runs": 5,
    "timeout_seconds": 30,
    "random_seed": 170035,
    "requested_cores": 1,
    "affinity": "enforced-on-linux-current-thread-and-gomaxprocs-1",
    "logging": "disabled",
    "tls_mode": "not-applicable",
    "keep_alive": "single-long-lived-child",
    "payload_bytes": 63,
    "connections": 1
  },
  "counter_catalog": "counter-catalog.json",
  "result_schema": "schema/result-v2.schema.json",
  "workloads": [
    {
      "id": "sync_unused",
      "kind": "zero_cost_gate",
      "available_phase": "P0",
      "enabled": true,
      "claim_eligible": false,
      "nomo_project": "reference/nomo/sync_unused",
      "expected_stdout": "sync-unused answer 3\n",
      "snapshot": "snapshots/sync-unused.json"
    },
    {
      "id": "process_pipe",
      "kind": "required_async_workload",
      "available_phase": "P2",
      "enabled": true,
      "claim_eligible": false,
      "nomo_project": "reference/nomo/process_pipe",
      "go_project": "reference/go/process_pipe",
      "fixture": {
        "source": "fixtures/process_pipe/fixture.c",
        "environment": "NOMO_PROCESS_FIXTURE"
      },
      "resource_limits": {
        "requested_cpu_cores": 1,
        "address_space_limit_bytes": 2147483648,
        "address_space_limit_platforms": [
          "Linux"
        ],
        "peak_rss_budget_bytes": 134217728
      },
      "operations_per_run": 256,
      "expected_stdout": "process-pipe 256 63\n",
      "snapshot": "snapshots/process-pipe.json",
      "note": "Runs the same 63-byte line protocol for 256 stdin/stdout/stderr exchanges against one identical fixture under one-core controls and a 128 MiB peak-RSS budget. Five samples and ratios are evidence only; they do not authorize a performance claim."
    },
    {
      "id": "task_spawn_complete",

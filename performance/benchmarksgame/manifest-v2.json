    "timed_lanes": [
      "candidate",
      "main",
      "c",
      "cpp",
      "go"
    ],
    "decisive_comparators": [
      "c",
      "cpp",
      "main"
    ],
    "diagnostic_lanes": [
      "go",
      "semantic-c"
    ],
    "semantic_c_timing": "untimed-correctness-control",
    "warmup_runs_per_lane": 2,
    "paired_blocks_per_batch": 30,
    "acceptance_batches": 2,
    "schedule": {
      "design": "Williams balanced Latin square for five timed lanes",
      "application": "independently repeated without pooling for release and emit-c build modes",
      "base_order_indices": [
        0,
        1,
        4,
        2,
        3
      ],
      "sequences_per_cycle": 10,
      "cycle_repetitions": 3,
      "property": "Each lane appears six times in each position and every directed adjacent pair appears six times per batch."
    },
    "statistics": {
      "transform": "ln(candidate_wall_ns / comparator_wall_ns)",
      "point_ratio": "exp(mean_log_ratio)",
      "confidence_bound": "exp(mean_log_ratio + t(0.99,29) * sample_standard_error)",
      "confidence_side": "upper-one-sided",
      "confidence_level": 0.99,
      "degrees_of_freedom": 29,
      "t_critical": 2.462021360150384,
      "suite_weighting": "equal-weight mean of the three workload log ratios within each paired block",
      "outlier_removal": false
    },
    "correctness_timeout_seconds": 120,
    "build_timeout_seconds": 600,
    "hard_timeout_seconds": 3600,
    "compile_time_in_run_time": false,
    "gomaxprocs": 1,
    "formal_stdout": "captured-and-verified-for-every-sample",
    "environment_anomaly_policy": "invalidate the complete affected batch; retain its artifact and reason",
    "batch_invalidation": {
      "decisive_reference_lanes": [
        "c",
        "cpp"
      ],
      "diagnostic_reference_lanes": [
        "go"
      ],
      "reference_drift_formula": "max(geomean(blocks 16..30) / geomean(blocks 1..15), inverse) - 1",
      "reference_drift_max": 0.02,
      "paired_ratio_comparators": [
        "c",
        "cpp",
        "main"
      ],
      "paired_ratio_rsd_formula": "sample_stdev(candidate_wall / comparator_wall) / arithmetic_mean(candidate_wall / comparator_wall)",
      "paired_ratio_rsd_max": 0.03,
      "maximum_reruns": 1,
      "outlier_removal": false
    },
    "claims": "Only two independently qualified passing batches in each of the release and emit-c build modes on a canonical host can be claim-eligible for this frozen suite."
  },
  "thresholds": {
    "inclusive": true,
    "workload": {
      "c_u99_max": 1.05,

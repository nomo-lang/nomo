  "license": "BSD-3-Clause",
  "methodology_urls": [
    "https://benchmarksgame-team.pages.debian.net/benchmarksgame/performance/comparable.html",
    "https://benchmarksgame-team.pages.debian.net/benchmarksgame/how-programs-are-measured.html",
    "https://benchmarksgame-team.pages.debian.net/benchmarksgame/license.html"
  ],
  "methodology": {
    "implementations": [
      "nomo",
      "c",
      "go"
    ],
    "measured_runs": 12,
    "cpu_statistics_exclude_first_run": true,
    "warmup_runs": 0,
    "first_formal_run_included_in_wall_min": true,
    "stdout_after_first_run": "/dev/null",
    "random_seed": 20260727,
    "rotation_algorithm": "For each workload, seed Python random.Random with random_seed plus the zero-based workload index and shuffle [nomo,c,go] independently for each round.",
    "slow_cutoff_seconds": 600,
    "hard_timeout_seconds": 3600,
    "correctness_timeout_seconds": 120,
    "build_timeout_seconds": 600,
    "affinity_enforced": false,
    "gomaxprocs": 1,
    "wall_summary": "minimum, median, and inclusive-quartile IQR across all completed samples",
    "cpu_summary": "mean and two-sided 95% Student-t confidence interval across runs 2 through 12",
    "rss_summary": "per-run peak RSS plus median and maximum",
    "slow_program_rule": "An implementation whose first formal run reaches 600 seconds is explicitly downgraded to one sample; twelve-run statistics remain null.",
    "compile_time_in_run_time": false,
    "claims": "Exploratory local evidence only; not eligible for language-wide or Benchmarks Game website claims."
  },
  "toolchains": {
    "nomo": {
      "required_version": "0.0.0-20260721120555",
      "build": "nomo build <project> --emit-c"
    },
    "clang": {
      "required_family": "clang",
      "flags": [
        "-std=c99",
        "-O3",
        "-DNDEBUG",
        "-fomit-frame-pointer"
      ]
    },
    "go": {
      "required_version": "go1.25.12",
      "runtime_environment": {
        "GOMAXPROCS": "1"
      }
    }
  },

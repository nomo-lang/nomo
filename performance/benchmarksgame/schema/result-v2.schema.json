        "correctness",
        "batches",
        "verdict"
      ],
      "properties": {
        "build_mode": { "enum": ["release", "emit-c"] },
        "status": { "enum": ["unavailable", "ineligible", "completed"] },
        "reason": { "type": "string", "minLength": 1 },
        "correctness": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/correctness" }
        },
        "batches": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/batch" }
        },
        "verdict": { "enum": ["not_evaluated", "pass", "fail"] }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "completed" } } },
          "then": {
            "properties": {
              "correctness": { "minItems": 3, "maxItems": 3 },
              "batches": { "minItems": 2, "maxItems": 3 },
              "verdict": { "enum": ["pass", "fail"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "enum": ["unavailable", "ineligible"] }
            }
          },
          "then": {
            "properties": {
              "verdict": { "const": "not_evaluated" }
            }
          }
        }
      ]
    }
  }
}

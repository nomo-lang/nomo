{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nomo-lang.org/schemas/benchmarksgame-result-v2.json",
  "title": "Nomo RFC 0043 Benchmarks Game parity result",
  "type": "object",
  "required": [
    "schema",
    "suite",
    "manifest_version",
    "mode",
    "status",
    "created_at_utc",
    "claims",
    "provenance",
    "release_lanes",
    "builds",
    "correctness",
    "protocols",
    "overall_verdict"
  ],
  "properties": {
    "schema": { "const": 2 },
    "suite": { "const": "nomo-benchmarksgame-cpu-parity-v2" },
    "manifest_version": { "const": "2026-07-28" },
    "mode": { "enum": ["correctness", "prepare", "measure"] },
    "status": {
      "enum": ["correctness-only", "prepared", "unavailable", "ineligible", "completed"]
    },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "claims": { "$ref": "#/$defs/claims" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "release_lanes": {
      "type": "object",
      "required": ["candidate", "main"],
      "properties": {
        "candidate": { "$ref": "#/$defs/releaseLane" },
        "main": { "$ref": "#/$defs/releaseLane" }
      },
      "additionalProperties": false
    },
    "builds": {
      "type": "object",
      "propertyNames": {
        "enum": ["spectral-norm", "n-body", "fannkuch-redux"]
      },
      "additionalProperties": { "$ref": "#/$defs/workloadBuild" }
    },
    "correctness": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/correctness" }
    },
    "protocols": {
      "type": "object",
      "required": ["release", "emit-c"],
      "properties": {
        "release": { "$ref": "#/$defs/protocol" },
        "emit-c": { "$ref": "#/$defs/protocol" }
      },
      "additionalProperties": false
    },
    "overall_verdict": { "enum": ["not_evaluated", "pass", "fail"] }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "correctness-only" } } },
      "then": {
        "properties": {
          "mode": { "const": "correctness" },
          "correctness": { "minItems": 3, "maxItems": 3 },
          "overall_verdict": { "const": "not_evaluated" },
          "claims": {
            "properties": { "claim_eligible": { "const": false } }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "prepared" } } },
      "then": {
        "properties": {
          "mode": { "const": "prepare" },
          "correctness": { "maxItems": 0 },
          "builds": { "minProperties": 3, "maxProperties": 3 },
          "overall_verdict": { "const": "not_evaluated" },
          "claims": {
            "properties": { "claim_eligible": { "const": false } }
          },
          "protocols": {
            "properties": {
              "release": {
                "properties": { "status": { "const": "unavailable" } }
              },
              "emit-c": {
                "properties": { "status": { "const": "unavailable" } }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "enum": ["unavailable", "ineligible"] }
        }
      },
      "then": {
        "properties": {
          "overall_verdict": { "const": "not_evaluated" },
          "claims": {
            "properties": { "claim_eligible": { "const": false } }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "completed" } } },
      "then": {
        "properties": {
          "mode": { "const": "measure" },
          "correctness": { "maxItems": 0 },
          "builds": { "minProperties": 3, "maxProperties": 3 },
          "release_lanes": {
            "properties": {
              "candidate": {
                "properties": { "status": { "const": "available" } }
              },
              "main": {
                "properties": { "status": { "const": "available" } }
              }
            }
          },
          "overall_verdict": { "enum": ["pass", "fail"] },
          "protocols": {
            "properties": {
              "release": {
                "properties": { "status": { "const": "completed" } }
              },
              "emit-c": {
                "properties": { "status": { "const": "completed" } }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claims": {
      "type": "object",
      "required": ["claim_eligible", "scope", "limitations"],
      "properties": {
        "claim_eligible": { "type": "boolean" },
        "scope": {
          "const": "RFC 0043 frozen three-workload CPU parity suite only"
        },
        "limitations": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": [
        "argv",
        "command",
        "cwd",
        "duration_ns",
        "exit_code",
        "environment"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "command": { "type": "string", "minLength": 1 },
        "cwd": { "type": ["string", "null"] },
        "duration_ns": { "type": "integer", "minimum": 0 },
        "exit_code": { "const": 0 },
        "environment": { "type": "object" }
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "toolFile": {
      "type": "object",
      "required": ["path", "sha256", "version_output"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "version_output": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "staticAuthorization": {
      "type": "object",
      "required": [
        "kind",
        "status",
        "eligible",
        "policy",
        "qualification_path",
        "qualification_sha256",
        "checks",
        "missing_or_unqualified",
        "provided_bindings",
        "expected_bindings",
        "binding_mismatches",
        "dynamic_policy",
        "reason"
      ],
      "properties": {
        "kind": { "const": "canonical-host-static-authorization-v1" },
        "status": { "enum": ["eligible", "ineligible"] },
        "eligible": { "type": "boolean" },
        "policy": { "const": "fail-closed" },
        "qualification_path": { "type": ["string", "null"] },
        "qualification_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "canonical_host_id": { "type": "string", "minLength": 1 },
        "captured_at_utc": { "type": "string", "format": "date-time" },
        "checks": { "type": "object" },
        "missing_or_unqualified": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "provided_bindings": { "type": ["object", "null"] },
        "expected_bindings": { "type": "object", "minProperties": 7 },
        "binding_mismatches": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "dynamic_policy": { "$ref": "#/$defs/dynamicPolicy" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["label", "status", "reason"],
      "properties": {
        "label": { "enum": ["candidate", "main", "current"] },
        "status": { "enum": ["available", "unavailable"] },
        "reason": { "type": "string", "minLength": 1 },
        "help_command": { "$ref": "#/$defs/command" },
        "nomo_path": { "type": "string" },
        "nomo_sha256": { "$ref": "#/$defs/sha256" },
        "emit_c_fallback_used": { "const": false }
      },
      "additionalProperties": false
    },
    "compilerBuild": {
      "type": "object",
      "required": [
        "repository_before",
        "repository_after",
        "expected_commit",
        "detached_head",
        "origin_main_commit",
        "remote_main_commit",
        "origin_url",
        "normalized_origin",
        "command",
        "environment",
        "cargo",
        "binary",
        "stdout",
        "stderr"
      ],
      "properties": {
        "repository_before": { "type": "object" },
        "repository_after": { "type": "object" },
        "expected_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "detached_head": { "const": true },
        "origin_main_commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "remote_main_commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "origin_url": { "type": "string", "minLength": 1 },
        "normalized_origin": { "const": "github.com/nomo-lang/nomo" },
        "command": { "$ref": "#/$defs/command" },
        "environment": {
          "type": "object",
          "required": ["CARGO_TARGET_DIR"],
          "properties": {
            "CARGO_TARGET_DIR": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "cargo": { "$ref": "#/$defs/toolFile" },
        "binary": { "$ref": "#/$defs/file" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" }
      },
      "additionalProperties": false
    },
    "releaseLane": {
      "type": "object",
      "required": ["label", "status", "reason", "emit_c_fallback_used"],
      "properties": {
        "label": { "enum": ["candidate", "main"] },
        "status": { "enum": ["available", "unavailable"] },
        "reason": { "type": "string", "minLength": 1 },
        "emit_c_fallback_used": { "const": false },
        "help_command": { "$ref": "#/$defs/command" },
        "nomo_path": { "type": "string" },
        "nomo_sha256": { "$ref": "#/$defs/sha256" },
        "checkout": { "type": "string" },
        "expected_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "detached_head": { "const": true },
        "repository": { "type": "object" },
        "compiler_build": { "$ref": "#/$defs/compilerBuild" },
        "origin_url": { "type": "string", "minLength": 1 },
        "normalized_origin": { "const": "github.com/nomo-lang/nomo" },
        "capabilities": {
          "type": "object",
          "required": ["release", "emit-c"],
          "properties": {
            "release": { "$ref": "#/$defs/capability" },
            "emit-c": { "$ref": "#/$defs/capability" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "available" } } },
          "then": {
            "required": [
              "nomo_path",
              "nomo_sha256",
              "checkout",
              "expected_commit",
              "detached_head",
              "repository",
              "origin_url",
              "normalized_origin",
              "compiler_build",
              "capabilities"
            ]
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "repository",
        "manifest_path",
        "manifest_sha256",
        "predecessor",
        "rfc",
        "host",
        "toolchains",
        "collector",
        "methodology",
        "thresholds",
        "environment_qualification",
        "source_lock",
        "prepared_bundle_sha256",
        "prepared_bundle_path",
        "qualification_request_path"
      ],
      "properties": {
        "repository": { "type": "object" },
        "manifest_path": { "type": "string", "minLength": 1 },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "predecessor": { "type": "object" },
        "rfc": { "type": "object" },
        "host": { "type": "object" },
        "toolchains": { "type": "object" },
        "collector": { "type": "object" },
        "methodology": { "type": "object" },
        "thresholds": { "type": "object" },
        "environment_qualification": { "$ref": "#/$defs/staticAuthorization" },
        "prepared_bundle_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "prepared_bundle_path": { "type": ["string", "null"] },
        "qualification_request_path": { "type": ["string", "null"] },
        "source_lock": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "object" }
        }
      },
      "additionalProperties": false
    },
    "referenceBuild": {
      "type": "object",
      "required": [
        "kind",
        "source_files",
        "compiled_sources",
        "commands",
        "compiler_output",
        "generated_c",
        "binaries",
        "compile_time_excluded_from_run_time"
      ],
      "properties": {
        "kind": { "const": "reference-and-correctness-baseline" },
        "source_files": { "type": "object" },
        "compiled_sources": { "type": "object" },
        "commands": {
          "type": "object",
          "required": ["c_build", "cpp_build", "semantic-c_build", "go_build"],
          "additionalProperties": { "$ref": "#/$defs/command" }
        },
        "compiler_output": { "type": "object" },
        "generated_c": { "type": ["object", "null"] },
        "binaries": { "type": "object" },
        "compile_time_excluded_from_run_time": { "const": true }
      },
      "additionalProperties": false
    },
    "generatedC": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "unmodified_after_build": { "const": true },
        "unmodified_after_emit": { "const": true }
      },
      "additionalProperties": false
    },
    "releaseBackend": {
      "type": "object",
      "required": [
        "schema",
        "complete_argv",
        "compiler",
        "objects",
        "compile_commands",
        "link_command",
        "generated_c",
        "binary"
      ],
      "properties": {
        "schema": { "const": 1 },
        "complete_argv": { "const": true },
        "compiler": {
          "type": "object",
          "required": ["path", "realpath", "sha256", "version_output", "target_triple"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "realpath": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "version_output": { "type": "string", "minLength": 1 },
            "target_triple": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "objects": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/file" }
        },
        "compile_commands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/command" }
        },
        "link_command": { "$ref": "#/$defs/command" },
        "generated_c": { "$ref": "#/$defs/file" },
        "binary": { "$ref": "#/$defs/file" }
      },
      "additionalProperties": false
    },
    "releaseBuild": {
      "type": "object",
      "required": [
        "kind",
        "lane",
        "repository",
        "nomo",
        "source",
        "command",
        "stdout",
        "stderr",
        "generated_c",
        "binary",
        "backend_provenance_path",
        "backend_provenance_sha256",
        "backend_provenance",
        "compile_time_excluded_from_run_time",
        "emit_c_fallback_used"
      ],
      "properties": {
        "kind": { "const": "real-nomo-release" },
        "lane": { "enum": ["candidate", "main"] },
        "repository": { "type": "object" },
        "nomo": { "$ref": "#/$defs/file" },
        "source": { "$ref": "#/$defs/file" },
        "command": { "$ref": "#/$defs/command" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "generated_c": { "$ref": "#/$defs/generatedC" },
        "binary": { "$ref": "#/$defs/file" },
        "backend_provenance_path": { "type": "string", "minLength": 1 },
        "backend_provenance_sha256": { "$ref": "#/$defs/sha256" },
        "backend_provenance": { "$ref": "#/$defs/releaseBackend" },
        "compile_time_excluded_from_run_time": { "const": true },
        "emit_c_fallback_used": { "const": false }
      },
      "additionalProperties": false
    },
    "emitCBuild": {
      "type": "object",
      "required": [
        "kind",
        "lane",
        "repository",
        "nomo",
        "source",
        "emit_command",
        "emit_stdout",
        "emit_stderr",
        "clang_command",
        "clang_stdout",
        "clang_stderr",
        "generated_c",
        "binary",
        "compile_time_excluded_from_run_time",
        "release_artifact_reused"
      ],
      "properties": {
        "kind": { "const": "nomo-emit-c-clang" },
        "lane": { "enum": ["candidate", "main"] },
        "repository": { "type": "object" },
        "nomo": { "$ref": "#/$defs/file" },
        "source": { "$ref": "#/$defs/file" },
        "emit_command": { "$ref": "#/$defs/command" },
        "emit_stdout": { "type": "string" },
        "emit_stderr": { "type": "string" },
        "clang_command": { "$ref": "#/$defs/command" },
        "clang_stdout": { "type": "string" },
        "clang_stderr": { "type": "string" },
        "generated_c": { "$ref": "#/$defs/generatedC" },
        "binary": { "$ref": "#/$defs/file" },
        "compile_time_excluded_from_run_time": { "const": true },
        "release_artifact_reused": { "const": false }
      },
      "additionalProperties": false
    },
    "workloadBuild": {
      "type": "object",
      "required": ["references", "modes"],
      "properties": {
        "references": { "$ref": "#/$defs/referenceBuild" },
        "modes": {
          "type": "object",
          "properties": {
            "release": {
              "type": "object",
              "required": ["candidate", "main"],
              "properties": {
                "candidate": { "$ref": "#/$defs/releaseBuild" },
                "main": { "$ref": "#/$defs/releaseBuild" }
              },
              "additionalProperties": false
            },
            "emit-c": {
              "type": "object",
              "required": ["candidate", "main"],
              "properties": {
                "candidate": { "$ref": "#/$defs/emitCBuild" },
                "main": { "$ref": "#/$defs/emitCBuild" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runtimeEnvironment": {
      "type": "object",
      "required": ["LC_ALL", "LANG"],
      "properties": {
        "LC_ALL": { "const": "C" },
        "LANG": { "const": "C" },
        "PATH": { "type": "string", "minLength": 1 },
        "TMPDIR": { "type": "string", "minLength": 1 },
        "SystemRoot": { "type": "string", "minLength": 1 },
        "WINDIR": { "type": "string", "minLength": 1 },
        "TEMP": { "type": "string", "minLength": 1 },
        "TMP": { "type": "string", "minLength": 1 },
        "GOMAXPROCS": { "const": "1" }
      },
      "additionalProperties": false
    },
    "sample": {
      "type": "object",
      "required": [
        "started_at_utc",
        "finished_at_utc",
        "command_argv",
        "command",
        "environment",
        "collector",
        "stdout",
        "wall_ns",
        "user_cpu_ns",
        "system_cpu_ns",
        "cpu_total_ns",
        "peak_rss_bytes",
        "exit_code",
        "stdout_raw_sha256",
        "stdout_normalized_sha256",
        "stdout_normalization",
        "executable_sha256"
      ],
      "properties": {
        "started_at_utc": { "type": "string", "format": "date-time" },
        "finished_at_utc": { "type": "string", "format": "date-time" },
        "command_argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "command": { "type": "string", "minLength": 1 },
        "environment": { "$ref": "#/$defs/runtimeEnvironment" },
        "collector": { "type": "string", "minLength": 1 },
        "stdout": { "const": "captured-and-verified" },
        "wall_ns": { "type": "integer", "exclusiveMinimum": 0 },
        "user_cpu_ns": { "type": "integer", "minimum": 0 },
        "system_cpu_ns": { "type": "integer", "minimum": 0 },
        "cpu_total_ns": { "type": "integer", "minimum": 0 },
        "peak_rss_bytes": { "type": "integer", "minimum": 0 },
        "exit_code": { "const": 0 },
        "stdout_raw_sha256": { "$ref": "#/$defs/sha256" },
        "stdout_normalized_sha256": { "$ref": "#/$defs/sha256" },
        "stdout_normalization": { "const": "crlf-to-lf-only-v1" },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "phase": { "enum": ["warmup", "sample"] },
        "build_mode": { "enum": ["release", "emit-c"] },
        "batch_index": { "type": "integer", "minimum": 1, "maximum": 2 },
        "attempt_index": { "type": "integer", "minimum": 1, "maximum": 3 },
        "warmup_index": { "type": "integer", "minimum": 1, "maximum": 2 },
        "block_index": { "type": "integer", "minimum": 1, "maximum": 30 },
        "order_position": { "type": "integer", "minimum": 1, "maximum": 5 }
      },
      "additionalProperties": false
    },
    "failedSample": {
      "type": "object",
      "required": [
        "status",
        "failure_kind",
        "failure_message",
        "failure_source",
        "started_at_utc",
        "finished_at_utc",
        "command_argv",
        "command",
        "environment",
        "collector",
        "stdout",
        "wall_ns",
        "user_cpu_ns",
        "system_cpu_ns",
        "cpu_total_ns",
        "peak_rss_bytes",
        "exit_code",
        "timed_out",
        "stdout_raw_sha256",
        "stdout_normalized_sha256",
        "stdout_normalization",
        "stdout_bytes",
        "stderr",
        "executable_sha256"
      ],
      "properties": {
        "status": { "const": "failed" },
        "failure_kind": {
          "enum": ["timeout", "output-mismatch", "process-failure", "collector-failure"]
        },
        "failure_message": { "type": "string", "minLength": 1 },
        "failure_source": { "type": "string", "minLength": 1 },
        "started_at_utc": { "type": "string", "format": "date-time" },
        "finished_at_utc": { "type": "string", "format": "date-time" },
        "command_argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "command": { "type": "string", "minLength": 1 },
        "environment": { "$ref": "#/$defs/runtimeEnvironment" },
        "collector": { "type": "string", "minLength": 1 },
        "stdout": { "const": "captured-failed" },
        "wall_ns": { "type": "integer", "exclusiveMinimum": 0 },
        "user_cpu_ns": { "type": ["integer", "null"], "minimum": 0 },

//! Owner-affine async TCP client and blocking network compatibility helpers.
package std.net

import std.net

/// Portable category for a network failure.
pub enum NetErrorKind {
    InvalidInput
    Unsupported
    Timeout
    Cancelled
    Closed
    Busy
    Limit
    Resolve
    Connect
    Read
    Write
    Reactor
}

/// Error returned when a network operation fails.
pub struct NetError {
    /// Portable failure category.
    pub kind: NetErrorKind
    /// Human-readable error description.
    pub message: string
}

/// An opaque owner-affine TCP stream.
pub struct TcpStream {
    handle: u64
}

/// A bounded binary chunk returned by an async TCP read.
pub struct TcpChunk {
    /// Bytes encoded as `u32` values in `0..=255`.
    pub data: Array<u32>
    /// Whether the peer has closed its write side.
    pub eof: bool
}

/// A bounded UTF-8 chunk returned by an async TCP read.
pub struct TcpTextChunk {
    /// UTF-8 text read from the stream.
    pub data: string
    /// Whether the peer has closed its write side.
    pub eof: bool
}

/// An opaque blocking TCP listener.
pub struct TcpListener {
    handle: u64
}

/// An opaque blocking UDP socket.
pub struct UdpSocket {
    handle: u64
}

/// A datagram received from a UDP peer.
pub struct UdpDatagram {
    /// Datagram payload decoded as a string.
    pub data: string
    /// Sender host name or address.
    pub host: string
    /// Sender port.
    pub port: i64
}

/// Opens an owner-affine TCP connection without blocking the async executor.
///
/// Numeric addresses use the reactor directly. On supported native targets,
/// hostnames use the toolchain's bounded resolver worker and return completion
/// to the owner executor.
pub suspend fn connect(host: string, port: i64, timeout_millis: u64) -> Result<TcpStream, NetError> {
    return net.connect(host, port, timeout_millis)
}

/// Opens a blocking TCP connection for preview compatibility.
pub fn connect_blocking(host: string, port: i64) -> Result<TcpStream, NetError> {
    return net.connect_blocking(host, port)
}

/// Binds a blocking TCP listener.
pub fn listen(host: string, port: i64) -> Result<TcpListener, NetError> {
    return net.listen(host, port)
}

/// Binds a blocking UDP socket.
pub fn udp_bind(host: string, port: i64) -> Result<UdpSocket, NetError> {
    return net.udp_bind(host, port)
}

impl TcpStream {
    /// Reads at least one byte, EOF, or a bounded failure without reading to EOF.
    pub suspend fn read(self, max_bytes: u64, timeout_millis: u64) -> Result<TcpChunk, NetError> {
        return self.read(max_bytes, timeout_millis)
    }

    /// Reads one bounded UTF-8 chunk without reading to EOF.
    pub suspend fn read_string(self, max_bytes: u64, timeout_millis: u64) -> Result<TcpTextChunk, NetError> {
        return self.read_string(max_bytes, timeout_millis)
    }

    /// Writes one bounded byte array completely or returns an error.
    pub suspend fn write(self, data: Array<u32>, timeout_millis: u64) -> Result<void, NetError> {
        return self.write(data, timeout_millis)
    }

    /// Writes one bounded string completely or returns an error.
    pub suspend fn write_string(self, content: string, timeout_millis: u64) -> Result<void, NetError> {
        return self.write_string(content, timeout_millis)
    }

    /// Reads until the peer closes its write side.
    pub fn read_to_string_blocking(self) -> Result<string, NetError> {
        return self.read_to_string_blocking()
    }

    /// Writes a string to the stream on the calling OS thread.
    pub fn write_string_blocking(self, content: string) -> Result<void, NetError> {
        return self.write_string_blocking(content)
    }

    /// Closes the stream.
    pub fn close(self) -> void {
        self.close()
    }
}

impl TcpListener {
    /// Accepts the next incoming TCP connection.
    pub fn accept(self) -> Result<TcpStream, NetError> {
        return self.accept()
    }

    /// Closes the listener.
    pub fn close(self) -> void {
        self.close()
    }
}

impl UdpSocket {
    /// Receives a datagram with at most `max_bytes` bytes.
    pub fn recv_from_string(self, max_bytes: i64) -> Result<UdpDatagram, NetError> {
        return self.recv_from_string(max_bytes)
    }

    /// Sends a string datagram to a host and port.
    pub fn send_to_string(self, content: string, host: string, port: i64) -> Result<void, NetError> {
        return self.send_to_string(content, host, port)
    }

    /// Closes the socket.
    pub fn close(self) -> void {
        self.close()
    }
}

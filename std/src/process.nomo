//! Process helpers.
package std.process

import std.process

/// Error returned when a process operation fails.
pub struct ProcessError {
    /// Human-readable error description.
    pub message: string
}

/// Captured process output.
pub struct ProcessOutput {
    /// Exit status returned by the process.
    pub status: i32
    /// Captured standard output.
    pub stdout: string
    /// Captured standard error.
    pub stderr: string
}

/// One explicit child-process environment entry.
pub struct ProcessEnv {
    pub name: string
    pub value: string
}

/// Shell-free child-process launch configuration.
pub struct ProcessCommand {
    pub program: string
    pub args: Array<string>
    pub cwd: Option<string>
    pub env: Array<ProcessEnv>
    pub inherit_env: bool
}

/// Opaque owner-affine asynchronous child-process handle.
pub struct ProcessChild {
    handle: u64
}

/// Opaque compatibility handle for the preview blocking process registry.
pub struct BlockingProcessChild {
    handle: u64
}

/// Portable child-process exit information.
pub struct ProcessExit {
    pub code: i32
    pub signal: i32
}

/// Incremental event returned by a controlled child.
pub enum ProcessEvent {
    StdinFlushed
    Stdout(string)
    Stderr(string)
    Exited(ProcessExit)
}

/// Stable, secret-safe error returned by controlled process operations.
pub struct ProcessControlError {
    pub code: string
    pub message: string
}

/// Exits the current process with a status code.
pub fn exit(code: i64) {
    process.exit(code)
}

/// Legacy blocking shell helper that runs a command and returns its status.
/// Suspend call graphs reject this compatibility API with E0891.
pub fn spawn(command: string) -> Result<i32, ProcessError> {
    return process.spawn(command)
}

/// Legacy blocking shell helper that runs a command and returns its status.
/// Suspend call graphs reject this compatibility API with E0891.
pub fn status(command: string) -> Result<i32, ProcessError> {
    return process.status(command)
}

/// Legacy blocking shell helper that returns standard output.
/// Suspend call graphs reject this compatibility API with E0891.
pub fn exec(command: string) -> Result<string, ProcessError> {
    return process.exec(command)
}

/// Legacy blocking shell helper that captures both output streams.
/// Suspend call graphs reject this compatibility API with E0891.
pub fn output(command: string) -> Result<ProcessOutput, ProcessError> {
    return process.output(command)
}

/// Starts a shell-free, owner-affine child without blocking the executor.
pub suspend fn start(command: ProcessCommand, timeout_millis: u64) -> Result<ProcessChild, ProcessControlError> {
    let result: Result<ProcessChild, ProcessControlError> = process.start(command, timeout_millis)
    return result
}

/// Queues one bounded UTF-8 payload for the child's standard input.
pub fn write_stdin(child: ProcessChild, data: string) -> Result<void, ProcessControlError> {
    return process.write_stdin(child, data)
}

/// Closes the child's standard input after pending data has flushed.
pub fn close_stdin(child: ProcessChild) -> Result<void, ProcessControlError> {
    return process.close_stdin(child)
}

/// Pulls the next standard-I/O, flush, or exit event without blocking the executor.
pub suspend fn next_event(child: ProcessChild, max_chunk_bytes: u64, timeout_millis: u64) -> Result<ProcessEvent, ProcessControlError> {
    let result: Result<ProcessEvent, ProcessControlError> = process.next_event(child, max_chunk_bytes, timeout_millis)
    return result
}

/// Observes child exit without consuming the final event.
pub fn try_wait(child: ProcessChild) -> Result<Option<ProcessExit>, ProcessControlError> {
    return process.try_wait(child)
}

/// Makes one non-waiting forced-termination request for the direct child.
pub fn terminate(child: ProcessChild) -> Result<void, ProcessControlError> {
    return process.terminate(child)
}

/// Idempotently closes the owner handle and transfers any reap to the runtime.
pub fn close_child(child: ProcessChild) {
    process.close_child(child)
}

/// Starts a child through the preview blocking compatibility registry.
/// Suspend call graphs reject this compatibility API with E0891.
pub fn start_blocking(command: ProcessCommand) -> Result<BlockingProcessChild, ProcessControlError> {
    return process.start_blocking(command)
}

/// Writes through the preview blocking compatibility registry.
/// Suspend call graphs reject this compatibility API with E0891.
pub fn write_stdin_blocking(child: BlockingProcessChild, data: string) -> Result<void, ProcessControlError> {
    return process.write_stdin_blocking(child, data)
}

/// Closes stdin through the preview blocking compatibility registry.
/// Suspend call graphs reject this compatibility API with E0891.
pub fn close_stdin_blocking(child: BlockingProcessChild) -> Result<void, ProcessControlError> {
    return process.close_stdin_blocking(child)
}

/// Waits for one event through the preview blocking compatibility registry.
/// Suspend call graphs reject this compatibility API with E0891.
pub fn next_event_blocking(child: BlockingProcessChild, max_chunk_bytes: u64, timeout_millis: u64) -> Result<ProcessEvent, ProcessControlError> {
    return process.next_event_blocking(child, max_chunk_bytes, timeout_millis)
}

/// Observes exit through the preview blocking compatibility registry.
/// Suspend call graphs reject this compatibility API with E0891.
pub fn try_wait_blocking(child: BlockingProcessChild) -> Result<Option<ProcessExit>, ProcessControlError> {
    return process.try_wait_blocking(child)
}

/// Terminates through the preview blocking compatibility registry.
/// Suspend call graphs reject this compatibility API with E0891.
pub fn terminate_blocking(child: BlockingProcessChild) -> Result<void, ProcessControlError> {
    return process.terminate_blocking(child)
}

/// Closes and reaps through the preview blocking compatibility registry.
/// Suspend call graphs reject this compatibility API with E0891.
pub fn close_child_blocking(child: BlockingProcessChild) {
    process.close_child_blocking(child)
}

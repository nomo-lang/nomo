//! Suspend primitives, scope-owned typed children, and isolated native workers.
package std.task

import std.result
import std.option
import std.task
import std.time

/// Opaque handle for one isolated native task.
pub struct Task {
    handle: u64
}

/// Read-only context made available to a task worker.
pub struct TaskContext {
    handle: u64
}

/// Stable error returned by task lifecycle operations.
pub struct TaskError {
    pub code: string
    pub message: string
}

/// A bounded FIFO publication channel owned by the async runtime.
///
/// Copies of the handle refer to the same queue. Values crossing the channel
/// must satisfy the compiler-known Send contract.
pub struct Channel<T> {
    handle: u64
}

/// Stable, secret-safe channel construction or runtime error.
pub struct ChannelError {
    pub code: string
    pub message: string
}

/// A failed send returns exactly one owner of the unsent value.
pub struct ChannelSendError<T> {
    pub error: ChannelError
    pub value: T
}

/// Immediate result of a non-suspending send attempt.
pub enum ChannelTrySend<T> {
    Sent
    Full(T)
    Closed(T)
    Failed(ChannelSendError<T>)
}

/// Immediate result of a non-suspending receive attempt.
pub enum ChannelTryReceive<T> {
    Value(T)
    Empty
    Closed
}

/// Terminal or polling outcome returned by `join`.
pub enum TaskJoin {
    Completed(string)
    Cancelled
    Timeout
}

/// Cooperatively yields the current suspend task to its owner executor.
pub suspend fn yield_now() {
    task.yield_now()
}

/// Cooperatively observes the current structured cancellation or deadline.
///
/// The call does not suspend. When cancellation is observed the compiler
/// completes the current suspend task with a stable TaskError instead of
/// returning to the source statement.
pub suspend fn check_cancelled() {
    task.check_cancelled()
}

/// Suspends the current task until a monotonic duration has elapsed.
///
/// A non-positive duration completes inline without registering or enqueueing.
/// Native positive durations use the owner executor; browser WASM currently
/// returns `runtime_unavailable` without evaluating the duration.
pub suspend fn sleep(duration: Duration) -> Result<void, TaskError> {
    return task.sleep(duration)
}

/// Creates a bounded FIFO channel.
///
/// Capacity must be in 1..=65536 and the slot buffer must not exceed 64 MiB.
pub fn channel<T>(capacity: u64) -> Result<Channel<T>, ChannelError> {
    return task.channel<T>(capacity)
}

/// Sends one value, suspending with FIFO backpressure while the queue is full.
///
/// The value is consumed. A closed or failed send returns it through
/// ChannelSendError<T>.
pub suspend fn send<T>(channel_value: Channel<T>, value: T) -> Result<void, ChannelSendError<T>> {
    return task.send(channel_value, value)
}

/// Receives the oldest value, suspending while an open queue is empty.
///
/// A closed and drained queue returns None.
pub suspend fn receive<T>(channel_value: Channel<T>) -> Option<T> {
    return task.receive(channel_value)
}

/// Attempts to send without suspending and always preserves one value owner.
pub fn try_send<T>(channel_value: Channel<T>, value: T) -> ChannelTrySend<T> {
    return task.try_send(channel_value, value)
}

/// Attempts to receive without suspending.
pub fn try_receive<T>(channel_value: Channel<T>) -> ChannelTryReceive<T> {
    return task.try_receive(channel_value)
}

/// Structured children use source forms recognized by the compiler:
///
/// task.scope {
///     let child = task.spawn child_function(arguments)
///     let joined: Result<ChildResult, TaskError> = task.join(child)
/// }
///
/// The compiler infers Task<ChildResult>, owns each immutable handle in one
/// lexical scope, and permits at most one join. Normal fallthrough cancels and
/// cleans up unjoined children; a final return evaluates its expression, then
/// performs the same cleanup before moving its result. Each structured-spawn
/// argument is also a compiler-known publication boundary:
/// Copy scalars stay available, while named strings, arrays, maps, and
/// structurally Send aggregates move into the child frame. Files, sockets,
/// process/SQLite/task handles, FFI handles, and aggregates containing them
/// remain Local/!Send. P3-A adds neither a `move` keyword nor a user-defined
/// `Send` interface.
///
/// A direct immutable
/// `let value: T = expression?` stores Err/None, cancels live children, and
/// then completes the helper. `let cancelled: Result<void, TaskError> =
/// task.cancel(child)` is the suspend-capable consuming cancel-and-join form:
/// it completes child cleanup before returning and the handle cannot be used
/// again. It is distinct from the legacy functions below.
///
/// task.deadline(duration) {
///     // one flat, non-value-producing structured body in the first slice
///     task.check_cancelled()
/// }
///
/// A non-positive deadline fails before its body with stable code `timeout`.
/// A positive deadline uses the owner-local monotonic timer and is disarmed on
/// normal fallthrough. Timeout cancels children and is observed by structured
/// join. Browser WASM currently rejects the scope without evaluating duration
/// or body.
///
/// Static receive/send/timer/join selection is also compiler recognized:
///
/// task.select {
///     task.receive(channel_value) => received {
///         consume(received)
///     }
///     task.send(channel_value, staged) => sent {
///         observe(sent)
///     }
///     task.join(child) => joined {
///         consume(joined)
///     }
///     task.sleep(duration) => timeout {
///         observe(timeout)
///     }
/// }
///
/// P3-C/P3-D accept 2 through 8 direct `task.receive`, `task.send`,
/// `task.sleep`, or `task.join` arms. Operands evaluate once from top to
/// bottom, an already-ready arm wins in source order, and a suspended winner
/// eagerly removes every loser before waking the owner frame. A send value is
/// staged and consumed at the select boundary; a selected join handle is
/// affine and cannot be reused after the statement. Losing join arms only
/// unregister their waiter, leaving the child to mandatory scope cleanup.
/// Direct arm `return`, typed `?`, and panic use structured cleanup; nested
/// suspension or nested structured control flow remains unsupported. Browser
/// WASM reports `runtime_unavailable` before evaluating operands.
/// Starts a non-capturing top-level worker with one deeply copied string input.
pub fn spawn(worker: task fn(TaskContext, string) -> string, input: string) -> Result<Task, TaskError> {
    return task.spawn(worker, input)
}

/// Reports whether cancellation has been requested for the current worker.
pub fn is_cancelled(context: TaskContext) -> bool {
    return task.is_cancelled(context)
}

/// Waits up to `timeout_millis` for one terminal task outcome.
pub fn join(task_value: Task, timeout_millis: u64) -> Result<TaskJoin, TaskError> {
    return task.join(task_value, timeout_millis)
}

/// Cooperatively requests task cancellation.
pub fn cancel(task_value: Task) -> Result<void, TaskError> {
    return task.cancel(task_value)
}

/// Releases a finished legacy task handle.
///
/// The compiler also recognizes `task.close(Channel<T>) -> void` as the
/// idempotent bounded-channel overload. It wakes blocked operations and keeps
/// buffered values available until drained.
pub fn close(task_value: Task) -> Result<void, TaskError> {
    return task.close(task_value)
}
